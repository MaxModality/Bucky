# Ignore everything by default. This repository should only track the
# minimum source inputs needed to rebuild the local macOS app.
*

# Repository metadata.
!.gitignore
!LICENSE
!CODEOWNERS

# Swift package and build entrypoint.
!Package.swift
!Package.resolved
!Makefile
!package.sh
!release.sh
!scripts/
!scripts/releaseTooling.py

# App source.
!Sources/
!Sources/**/
!Sources/**/*.swift

# Tests.
!Tests/
!Tests/**/
!Tests/**/*.swift
!tests/
!tests/tooling/
!tests/tooling/testReleaseTooling.py
!tests/tooling/mockTool.py

# App bundle metadata needed by the Makefile.
!packaging/
!packaging/Info.plist

# Agentic reosurces for future iterations.
!.agents/
!.agents/**
!docs/
!docs/investigations/
!docs/investigations/system-settings-discovery.md
!docs/superpowers/
!docs/superpowers/plans/
!docs/superpowers/plans/2026-05-14-bucky-refinements-implementation-plan.md
!docs/superpowers/specs/
!docs/superpowers/specs/**
!README.md
!AGENTS.md
!CHANGELOG.md

# GitHub repository automation.
!.github/
!.github/release.yml
